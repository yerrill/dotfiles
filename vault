#! /usr/bin/python3

# vault lock <file> - run file and file name through GPG and write output
# vault open <file> - decrypt file to tmpfs and stdout the path

import sys
import subprocess
from pathlib import Path

TMPFS = Path("/tmp/").resolve()
mode = sys.argv[1]
path = Path(sys.argv[2])


def encrypt(passphrase):
    plain_file_name = path.name.encode("utf-8")
    cmd = subprocess.run(
        ["gpg", "--batch", "--passphrase", passphrase, "-c"],
        input=plain_file_name,
        capture_output=True,
        check=True,
    )
    cypher_file_name = bytes(cmd.stdout).hex()
    cmd = subprocess.run(
        [
            "gpg",
            "--batch",
            "--output",
            cypher_file_name,
            "--passphrase",
            passphrase,
            "-c",
            path.resolve().as_posix(),
        ],
        check=True,
    )
    print(f"Encrypted as: {cypher_file_name}")


def decrypt(passphrase):
    cypher_file_name = bytes.fromhex(path.name)
    cmd = subprocess.run(
        ["gpg", "--batch", "--passphrase", passphrase, "-d"],
        input=cypher_file_name,
        capture_output=True,
        check=True,
    )
    plain_file_name = cmd.stdout.decode("utf-8")

    try:
        input(f'Decrypt {plain_file_name}?')
    except KeyboardInterrupt:
        sys.exit(0)

    temp_path = TMPFS / plain_file_name

    if temp_path.exists():
        print(f"Decrypt path already exists: {temp_path}")
        sys.exit(3)

    cmd = subprocess.run(
        [
            "gpg",
            "--batch",
            "--output",
            temp_path,
            "--passphrase",
            passphrase,
            "-d",
            path.resolve().as_posix(),
        ],
        check=True,
    )
    print(f"Decrypted as: {temp_path.as_posix()}")


if __name__ == "__main__":
    if not path.exists():
        print(f"Path does not exist: {path}")
        sys.exit(2)

    cmd = subprocess.run(
        ["findmnt", "-o", "FSTYPE", TMPFS.as_posix()], capture_output=True, check=True
    )

    if "tmpfs" not in str(cmd.stdout):
        print(f"{TMPFS} not a tmpfs")
        sys.exit(3)

    passphrase = input("Passphrase: ").encode("utf-8")

    if mode in ["lock", "l", "e"]:
        encrypt(passphrase)
    elif mode in ["open", "o", "d"]:
        decrypt(passphrase)
    else:
        print(f"Invalid mode: {mode}")
        sys.exit(1)
